{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dev",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--flavor",
                "dev",
            ],
            "cwd": "${workspaceFolder}/mobile/app",
        },
        {
            "name": "Dev Release",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--flavor",
                "dev",
                "--release",
            ],
            "cwd": "${workspaceFolder}/mobile/app",
        },
        {
            "name": "Dev Profile",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--flavor",
                "dev",
            ],
            "cwd": "${workspaceFolder}/mobile/app",
        },
        {
            "name": "Stage",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--flavor",
                "stage",
            ],
            "cwd": "${workspaceFolder}/mobile/app",
        },
        {
            "name": "Stage Release",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--flavor",
                "stage",
                "--release",
            ],
            "cwd": "${workspaceFolder}/mobile/app",
        },
        {
            "name": "Stage Profile",
            "program": "lib/main.dart",

        {
            "name": "Prod",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--flavor",
                "prod"
            ],
            "cwd": "${workspaceFolder}/mobile/app",
        },
        {
            "name": "Prod Release",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "args": [
                "--flavor",
                "prod",
                "--release",
            ],
            "cwd": "${workspaceFolder}/mobile/app",
        },
        {
            "name": "Integration tests",
            "type": "dart",
            "request": "launch",
